<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:padding="@dimen/space_16"
    android:orientation="vertical"
    android:layout_margin="@dimen/space_8">

    <!-- Top Row: Icon (Left) & Status Badge (Right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/space_12">

        <ImageView
            android:id="@+id/ivAppIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_app_placeholder"
            android:scaleType="fitCenter" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvAppBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chưa cài"
            android:textColor="@color/status_gray_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_badge_not_installed"
            android:paddingStart="@dimen/space_12"
            android:paddingEnd="@dimen/space_12"
            android:paddingTop="@dimen/space_4"
            android:paddingBottom="@dimen/space_4" />
    </LinearLayout>

    <!-- App Name -->
    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tên ứng dụng"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- App Subtitle (Version & Size) -->
    <TextView
        android:id="@+id/tvAppSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="v1.0 • 10 MB"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:layout_marginTop="@dimen/space_4"
        android:layout_marginBottom="@dimen/space_8" />

    <!-- App Description -->
    <TextView
        android:id="@+id/tvAppDesc"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="Mô tả ứng dụng..."
        android:textColor="@color/text_muted"
        android:textSize="14sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginBottom="@dimen/space_12" />

    <!-- Download Progress Bar (visible during download) -->
    <ProgressBar
        android:id="@+id/pbAppProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:progressTint="@color/accent_emerald"
        android:visibility="gone"
        android:layout_marginBottom="@dimen/space_8" />

    <!-- Action Buttons Container -->
    <!-- 1. Not Installed State: 1 Wide Install Button -->
    <LinearLayout
        android:id="@+id/layoutInstallBtn"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_btn_active"
        android:gravity="center"
        android:orientation="horizontal"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_download"
            android:tint="#FFFFFF"
            android:layout_marginEnd="@dimen/space_8" />

        <TextView
            android:id="@+id/tvInstallBtnText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cài đặt"
            android:textColor="@color/text_on_accent"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 2. Installed State: Open Button (75%) + Delete Button (25%) -->
    <LinearLayout
        android:id="@+id/layoutInstalledActions"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <!-- Open App Button -->
        <LinearLayout
            android:id="@+id/btnOpenApp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:background="@drawable/bg_btn_inactive"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginEnd="@dimen/space_8"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_open_ext"
                android:tint="@color/text_primary"
                android:layout_marginEnd="@dimen/space_12" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mở"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Delete / Uninstall Button -->
        <ImageView
            android:id="@+id/btnDeleteApp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_delete"
            android:src="@drawable/ic_trash"
            android:tint="@color/status_red_text"
            android:padding="@dimen/space_16"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Gỡ cài đặt" />
    </LinearLayout>

</LinearLayout>
