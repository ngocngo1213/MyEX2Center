<?xml version="1.0" encoding="utf-8"?>
<!-- Pressed feedback: ripple over the original shape (shape also bounds the ripple). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_on_accent">
    <item>
        <shape
            android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="#059669"
                android:endColor="#10B981" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#34D399" />
        </shape>
    </item>
</ripple>
