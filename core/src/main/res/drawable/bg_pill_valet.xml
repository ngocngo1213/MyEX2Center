<?xml version="1.0" encoding="utf-8"?>
<!-- Pressed feedback: ripple over the original shape (shape also bounds the ripple). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_neutral">
    <item>
        <shape
            android:shape="rectangle">
            <solid android:color="@color/accent_amber_bg" />
            <stroke android:width="1dp" android:color="@color/accent_amber" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</ripple>
