<?xml version="1.0" encoding="utf-8"?>
<!-- Pressed feedback: ripple over the original shape (shape also bounds the ripple). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_on_accent">
    <item>
        <shape
            android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#D97706"
                android:endColor="#F59E0B" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</ripple>
