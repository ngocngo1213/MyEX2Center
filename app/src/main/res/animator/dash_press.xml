<?xml version="1.0" encoding="utf-8"?>
<!-- Press feedback in the first frame: the control sinks slightly (no waiting for the car). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="0.96" android:duration="60" android:valueType="floatType" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="0.96" android:duration="60" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.0" android:duration="100" android:valueType="floatType" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.0" android:duration="100" android:valueType="floatType" />
        </set>
    </item>
</selector>
