<?xml version="1.0" encoding="utf-8"?>
<!--
  Dashboard: status strip (64dp) + Bento grid 6×3 that fills the rest of the 1920×896 app area.
  Widgets are placed in code from the chosen preset (ui/dash/DashPresets.kt).
  Every value that changes at runtime sits in a fixed-size box, so updating it never re-measures the screen.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dash_bg"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="16dp"
    android:paddingBottom="24dp">

    <!-- ===================== STATUS STRIP (normal / edit) ===================== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="64dp">

    <LinearLayout
        android:id="@+id/normalStrip"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvDigitalClock"
            style="@style/DashText"
            android:layout_width="136dp"
            android:layout_height="wrap_content"
            android:textSize="34sp"
            tools:text="23:48" />

        <!-- Fixed widths (no re-measure on every tick) with room for the widest value, plus a gap. -->
        <TextView
            android:id="@+id/tvOutsideTemp"
            style="@style/DashMuted"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:textSize="20sp"
            tools:text="31°C ngoài trời" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:background="@drawable/dash_card"
            android:contentDescription="Cần số"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp">

            <TextView android:id="@+id/tvGearP" style="@style/DashGear" android:text="P" />
            <TextView android:id="@+id/tvGearR" style="@style/DashGear" android:layout_marginStart="6dp" android:text="R" />
            <TextView android:id="@+id/tvGearN" style="@style/DashGear" android:layout_marginStart="6dp" android:text="N" />
            <TextView android:id="@+id/tvGearD" style="@style/DashGear" android:layout_marginStart="6dp" android:text="D" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Shown only while Crash Guard has stopped the automations or Valet is on. -->
        <TextView
            android:id="@+id/tvStatusChip"
            style="@style/DashChip"
            android:layout_width="wrap_content"
            android:layout_marginEnd="12dp"
            android:drawableStart="@drawable/ic_warning"
            android:visibility="gone"
            tools:text="Crash Guard đã ngắt"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/btnWifi"
            style="@style/DashChip"
            android:layout_width="wrap_content"
            android:maxWidth="360dp"
            android:contentDescription="Kết nối Wi-Fi cho xe"
            android:drawableStart="@drawable/ic_wifi"
            android:drawableEnd="@drawable/ic_chevron"
            android:ellipsize="end"
            tools:text="Geely_Home" />

        <!-- Edit the layout: only in P (locked otherwise). -->
        <TextView
            android:id="@+id/btnEditLayout"
            style="@style/DashChip"
            android:layout_width="wrap_content"
            android:layout_marginStart="12dp"
            android:contentDescription="Chỉnh bố cục Dashboard"
            android:drawableStart="@drawable/ic_edit"
            android:text="Chỉnh bố cục" />

        <ImageView
            android:id="@+id/btnNightBlackout"
            style="@style/DashIconChip"
            android:layout_marginStart="12dp"
            android:contentDescription="Tắt màn hình (Blackout)"
            android:src="@drawable/ic_night" />

        <ImageView
            android:id="@+id/btnSettings"
            style="@style/DashIconChip"
            android:layout_marginStart="12dp"
            android:contentDescription="Cài đặt"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <!-- Edit mode: presets, undo, reset, done. -->
    <LinearLayout
        android:id="@+id/editStrip"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView style="@style/DashText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chỉnh bố cục" android:textSize="26sp" />
            <TextView style="@style/DashMuted" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kéo để đổi chỗ · tự lưu và khoá khi rời số P" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/presetChips"
            style="@style/DashSeg"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:contentDescription="Bố cục có sẵn" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView android:id="@+id/btnEditAdd" style="@style/DashChip" android:layout_width="wrap_content" android:layout_marginEnd="12dp" android:text="+ Thêm widget" />
        <TextView android:id="@+id/btnEditUndo" style="@style/DashChip" android:layout_width="wrap_content" android:text="Hoàn tác" />
        <TextView android:id="@+id/btnEditReset" style="@style/DashChip" android:layout_width="wrap_content" android:layout_marginStart="12dp" android:text="Về mặc định" />
        <TextView
            android:id="@+id/btnEditDone"
            style="@style/DashChip"
            android:layout_width="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/dash_btn_on"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"
            android:text="Xong"
            android:textColor="@color/dash_on_accent"
            android:textSize="20sp" />
    </LinearLayout>
    </FrameLayout>

    <!-- ===================== BENTO GRID (+ edit layer) ===================== -->
    <FrameLayout
        android:id="@+id/gridHost"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1">

        <com.mipago.ex2center.ui.dash.BentoGridLayout
            android:id="@+id/bentoGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:bento_columns="6"
            app:bento_gap="16dp"
            app:bento_rows="3" />
        <!-- Edit mode: hidden widgets, slides over the bottom of the grid; tap a chip to add. -->
        <LinearLayout
            android:id="@+id/editTray"
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:layout_gravity="bottom"
            android:background="@drawable/dash_card"
            android:clickable="true"
            android:elevation="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView style="@style/DashText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/be_vietnam_pro_semibold" android:text="Widget đang ẩn" android:textSize="20sp" />
                <TextView style="@style/DashMuted" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chạm để thêm" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/trayItems"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/btnTrayClose"
                style="@style/DashChip"
                android:layout_width="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Đóng" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
