<?xml version="1.0" encoding="utf-8"?>
<!-- Ô 1×1: one function, the whole card is the button. Icon, name and state set from code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dash_chip"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="20dp"
    android:paddingEnd="24dp"
    android:paddingBottom="20dp"
    android:stateListAnimator="@animator/dash_press">

    <ImageView
        android:id="@+id/tileIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:importantForAccessibility="no"
        tools:src="@drawable/ic_night" />

    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tileTitle"
        style="@style/DashText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/be_vietnam_pro_semibold"
        android:maxLines="2"
        android:textSize="22sp"
        tools:text="Tắt màn hình" />

    <TextView
        android:id="@+id/tileState"
        style="@style/DashMuted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        tools:text="Chạm để bật lại" />
</LinearLayout>
