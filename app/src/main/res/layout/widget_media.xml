<?xml version="1.0" encoding="utf-8"?>
<!-- NHẠC 2×1 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/DashCard">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView style="@style/DashLabel" android:text="Nhạc" />

        <TextView
            android:id="@+id/tvMediaSource"
            style="@style/DashMuted"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            tools:text="· SmartTube" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvMediaTitle"
        style="@style/DashText"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:textSize="26sp"
        tools:text="VOV Giao thông 91 MHz" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView android:id="@+id/btnMediaPrev" style="@style/DashBtn" android:layout_width="76dp" android:layout_height="76dp" android:padding="24dp" android:contentDescription="Bài trước" android:src="@drawable/ic_prev" android:tint="@color/dash_text" />
        <ImageView android:id="@+id/btnMediaPlayPause" style="@style/DashBtn" android:layout_width="96dp" android:layout_height="76dp" android:layout_marginStart="12dp" android:padding="22dp" android:contentDescription="Phát / Tạm dừng" android:src="@drawable/ic_play" android:tint="@color/dash_text" />
        <ImageView android:id="@+id/btnMediaNext" style="@style/DashBtn" android:layout_width="76dp" android:layout_height="76dp" android:layout_marginStart="12dp" android:padding="24dp" android:contentDescription="Bài sau" android:src="@drawable/ic_next" android:tint="@color/dash_text" />

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_volume_up"
            android:tint="@color/dash_muted" />

        <SeekBar
            android:id="@+id/sbVolume"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:contentDescription="Âm lượng"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:progressDrawable="@drawable/dash_volume_track"
            android:splitTrack="false"
            android:thumb="@drawable/dash_volume_thumb" />

        <TextView
            android:id="@+id/tvVolumeValue"
            style="@style/DashText"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textSize="24sp"
            tools:text="11" />
    </LinearLayout>
</LinearLayout>
