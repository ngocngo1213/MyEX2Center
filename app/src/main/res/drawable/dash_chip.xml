<?xml version="1.0" encoding="utf-8"?>
<!-- Raised chip (header buttons, window pills, trunk button). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/dash_ripple">
    <item>
        <layer-list>
            <item>
                <shape><solid android:color="@color/dash_lo" /><corners android:radius="12dp" /></shape>
            </item>
            <item android:bottom="1dp">
                <shape><solid android:color="@color/dash_hi" /><corners android:radius="12dp" /></shape>
            </item>
            <item android:top="1dp" android:bottom="1dp">
                <shape><solid android:color="@color/dash_card" /><corners android:radius="12dp" /></shape>
            </item>
        </layer-list>
    </item>
</ripple>
