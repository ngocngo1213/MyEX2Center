<?xml version="1.0" encoding="utf-8"?>
<!-- Segmented control track. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape><solid android:color="@color/dash_hi" /><corners android:radius="14dp" /></shape>
    </item>
    <item android:bottom="1dp">
        <shape><solid android:color="@color/dash_lo" /><corners android:radius="14dp" /></shape>
    </item>
    <item android:top="1dp" android:bottom="1dp">
        <shape><solid android:color="@color/dash_well" /><corners android:radius="14dp" /></shape>
    </item>
</layer-list>
