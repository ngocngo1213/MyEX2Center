<?xml version="1.0" encoding="utf-8"?>
<!-- Card: matte surface lit from above (1px highlight on top, 1px shade at the bottom). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape><solid android:color="@color/dash_lo" /><corners android:radius="16dp" /></shape>
    </item>
    <item android:bottom="1dp">
        <shape><solid android:color="@color/dash_hi" /><corners android:radius="16dp" /></shape>
    </item>
    <item android:top="1dp" android:bottom="1dp">
        <shape><solid android:color="@color/dash_card" /><corners android:radius="16dp" /></shape>
    </item>
</layer-list>
